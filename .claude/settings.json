{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm emulators)",
      "Bash(pnpm seed:emulator:*)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm why:*)",
      "Bash(pnpm dlx shadcn@latest add:*)",
      "Bash(git tag --list:*)",
      "Bash(git fetch:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm approve-builds:*)",
      "Bash(pnpm exec firebase:*)",
      "Bash(firebase:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(pnpm version:*)",
      "Bash(pnpm dlx shadcn@latest init:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)",
      "Read(./.env.production)",
      "Bash(firebase deploy:*)",
      "Bash(npx firebase deploy:*)",
      "Bash(pnpm exec firebase deploy:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
