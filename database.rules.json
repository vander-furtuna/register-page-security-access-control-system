{
  "rules": {
    ".read": "auth != null",
    ".write": false,
    "system": {
      ".write": "auth != null"
    },
    "users": {
      ".write": "auth != null"
    },
    "logs": {
      ".write": "auth != null",
      ".indexOn": ["userPath", "userEmail", "timestamp"]
    },
    "pendingRegistration": {
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true && auth.token.email.matches(/.*@(alu\\.)?ufc\\.br$/) || !newData.exists())"
    },
    "pendingUser": {
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true && auth.token.email.matches(/.*@(alu\\.)?ufc\\.br$/) || !newData.exists())"
    },
    "members": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && auth.token.email.matches(/.*@(alu\\.)?ufc\\.br$/)"
    },
    "admins": {
      ".write": false
    },
    "devices": {
      "$deviceId": {
        "status": {
          ".write": "auth != null"
        },
        "inventory": {
          ".write": "auth != null"
        },
        "outages": {
          ".write": "auth != null"
        },
        "commands": {
          "$commandId": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true && auth.token.email.matches(/.*@(alu\\.)?ufc\\.br$/) || data.exists())"
          },
          ".indexOn": ["requestedAt"]
        }
      }
    }
  }
}
