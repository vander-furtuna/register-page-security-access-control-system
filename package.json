{
  "name": "pet-lock-web",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Painel web da fechadura eletrônica do PET Engenharia de Computação (UFC Sobral)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-pet-lock",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
